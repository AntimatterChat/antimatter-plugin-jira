{
	"key": "{{ .PluginKey }}",
	"name": "Antimatter Plugin ({{ .ExternalURL }})",
	"description": "Integrates Jira with Antimatter for in-place interactions and notifications",
	"vendor": {
		"name": "Antimatter",
		"url": "https://github.com/antimatterchat"
	},
	"baseUrl": "{{ .BaseURL }}",
	"links": {
		"self": "{{ .BaseURL }}{{ .RouteACJSON }}",
		"homepage": "https://docs.antimatter.example"
	},
	"authentication": {
		"type": "jwt"
	},
	"apiMigrations": {
		"gdpr": true
	},
	"lifecycle": {
		"installed": "{{ .RouteACInstalled }}",
		"uninstalled": "{{ .RouteACUninstalled }}"
	},
	"scopes": [ "READ", "WRITE", "ACT_AS_USER" ],
	"modules": {
		"generalPages": [
			{
				"url": "{{ .RouteACUserRedirectWithToken }}",
				"name": {
					"value": "User mapping and configuration page"
				},
				"key": "{{ .UserRedirectPageKey }}",
				"location": "none"
			}
		]
	}
}
